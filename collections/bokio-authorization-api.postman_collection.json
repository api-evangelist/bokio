          "id": "da65436a-045e-46d6-9dac-4a19835e91c6",
          "name": "Authorize the client",
          "request": {
            "name": "Authorize the client",
            "description": {
              "content": "OAuth 2.0 authorization endpoint to initiate the OAuth 2.0 Authorization Code grant to obtain an authorization code to exchange for an access token.\n\nUse Authorization Code grant to obtain access token for a Company.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The response type for the authorization request"
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<uuid>",
                  "description": "(Required) The client ID for the authorization request"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) The URI to redirect the user to after authorization. Must match one of the redirect URIs registered for the client."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The scope for the authorization request"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) An opaque value used by the client to maintain state between the request and callback. Required as protection against CSRF (cross-site request forgery) attacks."
                },
                {
                  "disabled": false,
                  "key": "bokio_tenantid",
                  "value": "<uuid>",
                  "description": "The Bokio tenant ID to authorize the integration to have access. Bokioio company ID will be the teant ID when the tenant_type is `company`."
                },
                {
                  "disabled": false,
                  "key": "bokio_tenanttype",
                  "value": "<string>",
                  "description": "The Bokio tenant type to authorize the integration to have access. Currently support only `company` tenant type."
                }
              ],
              "variable": []
            },
            "header": [
