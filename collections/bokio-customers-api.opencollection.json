{
  "opencollection": "1.0.0",
  "info": {
    "name": "Company authorization customers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bokio.se/v1/companies/:companyId/customers",
            "params": [
              {
                "name": "companyId",
                "value": "ea9ee4dd-fae3-4aec-a7db-6fc9cc1f8135",
                "type": "path",
                "description": "Unique identifier of the company"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "query",
                "value": "name==customer 1",
                "type": "query",
                "description": "Optional query to filter the data set with supported fields listed below and [available operations](filtering).\n\n| Field                | Type        |\n| -------------------- | ----------- |\n| name                 | string      |\n| type                 | string      |\n| vatNumber            | string      |\n| orgNumber            | string      |\n| modifiedDateTime     | date-time   |\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all customers for the company. Use the query parameters to filter and navigate through the results.\n**Scope:** `customers:read`"
        },
        {
          "info": {
            "name": "Create a customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bokio.se/v1/companies/:companyId/customers",
            "params": [
              {
                "name": "companyId",
                "value": "ea9ee4dd-fae3-4aec-a7db-6fc9cc1f8135",
                "type": "path",
                "description": "Unique identifier of the company"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a customer for the company.\n\n**Scope:** `customers:write`\n"
        },
        {
          "info": {
            "name": "Get a customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bokio.se/v1/companies/:companyId/customers/:customerId",
            "params": [
              {
                "name": "companyId",
                "value": "ea9ee4dd-fae3-4aec-a7db-6fc9cc1f8135",
                "type": "path",
                "description": "Unique identifier of the company"
              },
              {
                "name": "customerId",
                "value": "55c899c5-82b2-47fa-9c51-e35fc9b26443",
                "type": "path",
                "description": "Unique identifier of the customer"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the information of the customer with the matching customerId.\n\n**Scope:** `customers:read`\n"
        },
        {
          "info": {
            "name": "Update a customer",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bokio.se/v1/companies/:companyId/customers/:customerId",
            "params": [
              {
                "name": "companyId",
                "value": "ea9ee4dd-fae3-4aec-a7db-6fc9cc1f8135",
                "type": "path",
                "description": "Unique identifier of the company"
              },
              {
                "name": "customerId",
                "value": "55c899c5-82b2-47fa-9c51-e35fc9b26443",
                "type": "path",
                "description": "Unique identifier of the customer"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing customer for the company.\n\n**Scope:** `customers:write`\n"
        },
        {
          "info": {
            "name": "Delete a customer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bokio.se/v1/companies/:companyId/customers/:customerId",
            "params": [
              {
                "name": "companyId",
                "value": "ea9ee4dd-fae3-4aec-a7db-6fc9cc1f8135",
                "type": "path",
                "description": "Unique identifier of the company"
              },
              {
                "name": "customerId",
                "value": "55c899c5-82b2-47fa-9c51-e35fc9b26443",
                "type": "path",
                "description": "Unique identifier of the customer"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an existing customer for the company.\n\nNOTE: Currently only supports deleting customers that have been added through the API.\n\n**Scope:** `customers:write`\n"
        }
      ]
    }
  ],
  "bundled": true
}