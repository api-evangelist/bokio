          "info": {
            "name": "[Preview] Get supplier invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bokio.se/v1/companies/:companyId/supplier-invoices",
            "params": [
              {
                "name": "companyId",
                "value": "a9d8f1c2-6f34-4e4f-9d8a-2a4d3d5f7b91",
                "type": "path",
                "description": "Unique identifier of the company"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "query",
                "value": "dueDate==2023-10-15&&currency==SEK",
                "type": "query",
                "description": "Optional query to filter the data set with supported fields listed below and [available operations](filtering).\n\n| Field             | Type   |\n| ----------------- | ------ |\n| supplierRef.id    | string |\n| invoiceNumber     | string |\n| totalAmount       | number |\n| currency          | string |\n| invoiceDate       | date   |\n| dueDate           | date   |\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all supplier invoices for the company. Use the query parameters to filter and navigate through the results.\n\n**Scope:** `supplier-invoices:read`\n"
        },
