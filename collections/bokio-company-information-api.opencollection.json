{
  "opencollection": "1.0.0",
  "info": {
    "name": "Company authorization company-information API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "company-information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve company information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bokio.se/v1/companies/:companyId/company-information",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the company"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the information of the company.\n\n**Scope:** `company-information:read`\n"
        }
      ]
    }
  ],
  "bundled": true
}