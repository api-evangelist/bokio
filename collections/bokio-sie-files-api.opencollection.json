{
  "opencollection": "1.0.0",
  "info": {
    "name": "Company authorization sie-files API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "sie-files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download SIE file for a fiscal year",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bokio.se/v1/companies/:companyId/sie/:fiscalYearId/download",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the company"
              },
              {
                "name": "fiscalYearId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the fiscal year"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint downloads the SIE file for the provided fiscal year.\nThe SIE file is used for accounting purposes in Sweden.\n\n**Scope:** `sie:read`\n"
        }
      ]
    }
  ],
  "bundled": true
}